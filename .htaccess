RewriteEngine On

# 1. Hide .php extension
# To view /file, request /file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^\.]+)$ $1.php [NC,L]

# 2. Block access to sensitive directories
RewriteRule ^(config|sql|includes)/ - [F,L]
RewriteRule ^(\.env|\.git) - [F,L]

# 3. Prevent directory listing
Options -Indexes
